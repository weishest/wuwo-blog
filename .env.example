# Copy to `.env` (gitignored). Used only by `npm run images:publish`, never by the build.
# See docs/IMAGES.md.

# AWS CLI profile. A named profile or an SSO profile (`aws sso login --profile <name>`).
AWS_PROFILE=wuwo-blog-publisher
AWS_REGION=eu-west-1

# Outputs of the CDK stack in infra/ (`npx cdk deploy` prints them).
S3_BUCKET=
# Public domain of the distribution, without scheme: d111111abcdef8.cloudfront.net or img.example.com.
# Keep it equal to `images.cdnDomain` in src/site.config.ts (the build needs it without AWS access).
CLOUDFRONT_DOMAIN=
