{
  "name": "blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "images:publish": "node scripts/publish-images.ts",
    "images:check": "node scripts/publish-images.ts --check",
    "test": "node --test \"scripts/**/*.test.ts\"",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.5",
    "satteri": "^0.10.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@types/node": "^26.6.6",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/check-staged-images.ts"
  }
