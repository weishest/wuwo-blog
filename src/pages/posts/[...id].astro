---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { PostLayout } from '@theme';
import { getPostSummaries } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPostSummaries(); // newest first
  return posts.map((post, i) => ({
    params: { id: post.entry.id },
    props: { post, next: posts[i - 1], prev: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { post, prev, next } = Astro.props;
const { Content } = await render(post.entry);
---

<PostLayout post={post} prev={prev} next={next}>
  <Content />
</PostLayout>
