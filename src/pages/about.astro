---
import { PageLayout } from '@theme';
import { siteConfig } from '../site.config';
import { withBase } from '../lib/url';
---

<PageLayout title="About" description={`About ${siteConfig.author} and this blog.`}>
  <p>
    Hi, I’m {siteConfig.author}. This is where I write about software, tools, and things I’m
    learning.
  </p>
  <p>
    The site is built with <a href="https://astro.build">Astro</a> and hosted on GitHub Pages. Its
    look comes from a swappable theme; see <code>THEMES.md</code> in the repository.
  </p>
  <p>
    Subscribe via <a href={withBase('/rss.xml')}>RSS</a>.
  </p>
</PageLayout>
