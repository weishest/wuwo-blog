---
/** "July 21, 2029 by Author". Pass showDate to include the date. (partials/byline.hbs) */
import { siteConfig } from '../../../site.config';
import { formatDate } from '../../../lib/format';
import { withBase } from '../../../lib/url';

interface Props {
  date: Date;
  showDate?: boolean;
}
const { date, showDate = false } = Astro.props;
const iso = date.toISOString().slice(0, 10);
---

<p class="byline">
  {showDate && <time datetime={iso}>{formatDate(date, 'long')}</time>}{showDate && ' '}by{' '}<a href={withBase('/about/')}>{siteConfig.author}</a>
</p>
