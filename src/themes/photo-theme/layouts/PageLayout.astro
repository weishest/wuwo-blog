---
/** Static page (page.hbs): split header with title and excerpt, then the body column. */
import type { PageProps } from '../../contract';
import BaseLayout from './BaseLayout.astro';
import Split from '../components/Split.astro';

type Props = PageProps;
const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="article page">
    <Split mode="page" title={title} excerpt={description} />
    <div class="post-body no-image">
      <div class="post-content">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
