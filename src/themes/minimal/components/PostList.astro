---
import type { PostSummary } from '../../../lib/posts';
import PostCard from './PostCard.astro';

interface Props {
  posts: PostSummary[];
}
const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">Nothing here yet.</p>
  ) : (
    <ul class="posts">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </ul>
  )
}

<style>
  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .empty {
    color: var(--color-muted);
  }
</style>
