---
import { siteConfig } from '../../../site.config';
import { withBase } from '../../../lib/url';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: withBase('/blog/'), label: 'writing' },
  { href: withBase('/tags/'), label: 'tags' },
  { href: withBase('/about/'), label: 'about' },
  { href: withBase('/rss.xml'), label: 'rss' },
];
const path = Astro.url.pathname;
---

<header class="container header">
  <a class="site-title" href={withBase('/')}>{siteConfig.title}</a>
  <nav aria-label="Main">
    {
      links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
    <ThemeToggle />
  </nav>
</header>

<style>
  .header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-5) var(--space-4);
  }
  .site-title {
    font-variant: small-caps;
    letter-spacing: 0.08em;
    font-size: 1.25rem;
    color: var(--color-text);
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
  }
  nav a {
    font-size: var(--font-size-small);
    font-variant: small-caps;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-accent);
  }
</style>
