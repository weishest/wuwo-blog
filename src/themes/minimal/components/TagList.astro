---
interface Props {
  tags: { name: string; url: string }[];
}
const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags">
      {tags.map((t) => (
        <li>
          <a href={t.url}>#{t.name}</a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  a {
    color: var(--color-muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--color-accent);
  }
</style>
