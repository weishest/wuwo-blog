---
interface Props {
  tags: { name: string; url: string; count?: number }[];
}
const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags">
      {tags.map((t) => (
        <li>
          <a href={t.url}>
            {t.name}
            {t.count !== undefined && <span class="count">{t.count}</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: var(--font-size-small);
    font-weight: 500;
    text-decoration: none;
  }
  a:hover {
    background: var(--color-accent);
    color: var(--color-bg);
    text-decoration: none;
  }
  .count {
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }
</style>
