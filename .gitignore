# build output
dist/
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*

# environment variables
.env
.env.*
!.env.example

# macOS
.DS_Store

# Post images are never committed. `npm run images:publish` uploads them to
# S3/CloudFront and rewrites the posts (docs/IMAGES.md). Theme assets in
# src/themes/ and public/ are not affected by these rules.
src/content/**/*.jpg
src/content/**/*.JPG
src/content/**/*.jpeg
src/content/**/*.JPEG
src/content/**/*.png
src/content/**/*.PNG
src/content/**/*.webp
src/content/**/*.WEBP
src/content/**/*.avif
src/content/**/*.AVIF
src/content/**/*.gif
src/content/**/*.GIF
src/content/**/*.svg
src/content/**/*.SVG
src/content/**/*.heic
src/content/**/*.HEIC

# local copies of published originals (not backed up by Git)
.image-archive/

# AWS CDK app in infra/
infra/node_modules/
infra/cdk.out/
